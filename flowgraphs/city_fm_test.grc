options:
  parameters:
    author: ''
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: City RF test (FM broadcast)
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: city_fm_test
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: City FM Test (FM Broadcast)
    window_size: 1500, 900
  states:
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '2.4e6'
  states:
    coordinate: [40, 12]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: ''
    value: '10'
  states:
    coordinate: [160, 12]
    rotation: 0
    state: enabled
- name: chan_rate
  id: variable
  parameters:
    comment: ''
    value: 'samp_rate/decim'
  states:
    coordinate: [280, 12]
    rotation: 0
    state: enabled
- name: audio_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states:
    coordinate: [420, 12]
    rotation: 0
    state: enabled
- name: audio_decim
  id: variable
  parameters:
    comment: ''
    value: '5'
  states:
    coordinate: [560, 12]
    rotation: 0
    state: enabled
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,1
    label: RF Gain (dB)
    min_len: '200'
    orient: Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '60'
    value: '20'
    widget: counter_slider
  states:
    coordinate: [40, 60]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,1
    label: Center Freq (MHz)
    min_len: '200'
    orient: Qt.Horizontal
    rangeType: float
    start: '88e6'
    step: '100e3'
    stop: '108e6'
    value: '100e6'
    widget: counter_slider
  states:
    coordinate: [40, 120]
    rotation: 0
    state: enabled
- name: fm_bw
  id: variable
  parameters:
    comment: ''
    value: '100e3'
  states:
    coordinate: [40, 200]
    rotation: 0
    state: enabled
- name: fm_trans
  id: variable
  parameters:
    comment: ''
    value: '50e3'
  states:
    coordinate: [160, 200]
    rotation: 0
    state: enabled
- name: fm_taps
  id: variable
  parameters:
    comment: ''
    value: 'firdes.low_pass(1.0, samp_rate, fm_bw, fm_trans)'
  states:
    coordinate: [280, 200]
    rotation: 0
    state: enabled

- name: uhd_usrp_source_0
  id: uhd_usrp_source
  parameters:
    affinity: ''
    alias: ''
    ant0: '"RX2"'
    bw0: '0'
    center_freq0: center_freq
    clock_rate: '0.0'
    comment: ''
    dev_addr: '""'
    dev_args: '""'
    gain0: rf_gain
    lo_export0: 'False'
    lo_source0: internal
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: '1'
    num_mboards: '1'
    otw: ''
    rx_agc0: Disabled
    samp_rate: samp_rate
    sd_spec0: ''
    stream_args: '""'
    stream_chans: '[]'
    sync: none
    type: fc32
  states:
    coordinate: [40, 300]
    rotation: 0
    state: enabled

- name: freq_xlating_fir_filter_xxx_0
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: '0'
    comment: ''
    decim: decim
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    taps: fm_taps
    type: ccf
  states:
    coordinate: [260, 300]
    rotation: 0
    state: enabled

- name: analog_wfm_rcv_0
  id: analog_wfm_rcv
  parameters:
    affinity: ''
    alias: ''
    audio_decimation: audio_decim
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    quad_rate: chan_rate
  states:
    coordinate: [480, 300]
    rotation: 0
    state: enabled

- name: audio_sink_0
  id: audio_sink
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_name: '""'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '1'
    ok_to_block: 'True'
    samp_rate: audio_rate
  states:
    coordinate: [700, 300]
    rotation: 0
    state: enabled

- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    alpha10: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    color10: '"dark blue"'
    comment: ''
    ctrlpanel: 'False'
    fc: center_freq
    fftsize: '2048'
    freqhalf: 'True'
    grid: 'False'
    gui_hint: 0,1,1,1
    label: Relative Gain
    label1: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    label10: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Wideband Spectrum"'
    nconnections: '1'
    showports: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    ymin: '-140'
    ymax: '10'
  states:
    coordinate: [40, 520]
    rotation: 0
    state: enabled

- name: qtgui_waterfall_sink_x_0
  id: qtgui_waterfall_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    alpha10: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    color10: '"dark blue"'
    comment: ''
    ctrlpanel: 'False'
    fc: center_freq
    fftsize: '2048'
    freqhalf: 'True'
    grid: 'False'
    gui_hint: 1,1,1,1
    label: Relative Gain
    label1: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    label10: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Wideband Waterfall"'
    nconnections: '1'
    showports: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    ymin: '-140'
    ymax: '10'
  states:
    coordinate: [520, 520]
    rotation: 0
    state: enabled

- name: qtgui_freq_sink_x_1
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    alpha10: '1.0'
    autoscale: 'False'
    average: '1.0'
    axislabels: 'True'
    bw: chan_rate
    color1: '"blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    color10: '"dark blue"'
    comment: ''
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'False'
    gui_hint: 0,2,1,1
    label: Relative Gain
    label1: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    label10: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"FM Baseband Spectrum"'
    nconnections: '1'
    showports: 'False'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    ymin: '-140'
    ymax: '10'
  states:
    coordinate: [1000, 520]
    rotation: 0
    state: enabled

connections:
- [uhd_usrp_source_0, '0', freq_xlating_fir_filter_xxx_0, '0']
- [uhd_usrp_source_0, '0', qtgui_freq_sink_x_0, '0']
- [uhd_usrp_source_0, '0', qtgui_waterfall_sink_x_0, '0']

- [freq_xlating_fir_filter_xxx_0, '0', analog_wfm_rcv_0, '0']
- [analog_wfm_rcv_0, '0', audio_sink_0, '0']
- [freq_xlating_fir_filter_xxx_0, '0', qtgui_freq_sink_x_1, '0']

metadata:
  file_format: 1
